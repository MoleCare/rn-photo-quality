{
  "name": "@molecare/photo-quality",
  "version": "0.2.0",
  "description": "On-device photo quality checks for React Native: exposure clipping, uneven lighting, sharpness, capture metadata and photo-to-photo comparability.",
  "main": "src/index.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoleCare/rn-photo-quality.git"
  },
  "bugs": {
    "url": "https://github.com/MoleCare/rn-photo-quality/issues"
  },
  "homepage": "https://github.com/MoleCare/rn-photo-quality#readme",
  "keywords": [
    "react-native",
    "photo",
    "camera",
    "image-quality",
    "sharpness",
    "exposure",
    "capture-metadata"
  ],
  "dependencies": {
    "jpeg-js": "^0.4.4"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0",
    "react-native-fs": ">=2.18.0",
    "@react-native-community/image-editor": ">=2.3.0",
    "react-native-device-info": ">=10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native)/)"
    ]
  },
  "scripts": {
    "test": "jest"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
